# Order Service Environment Variables

# Database configuration
PG_HOST=localhost
PG_PORT=5432
PG_USER=order_user
PG_PASSWORD=order_password
PG_DB=order_db
# DATABASE_URL=postgresql+asyncpg://order_user:order_password@order_db:5432/order_db

# Kafka configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ORDER_CREATED_TOPIC=order.created
ORDER_PROCESSED_TOPIC=order.processed

# Service configuration
SERVICE_NAME=order_service
DEBUG=false
